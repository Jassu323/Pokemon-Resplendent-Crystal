+	jr nc, .invalid
+	ld c, a
+	ld a, [wPokedexListingPresentation]
+	cp DEXLIST_LEGACY + 1
+	jr nc, .invalid
+	add a
+	add a
+	or c
+	or POKEDEX_POSITION_TAG
+	and a
+	ret
+.invalid
