+PokedexTypes_StoreColour::
+	push bc
+	push de
+	push hl
+	add a
+	add LOW(TYPES_COLORS)
+	ld l, a
+	ld h, HIGH(TYPES_COLORS)
+	ld b, [hl]
+	inc hl
+	ld e, [hl]
+	ld a, d
+	add a
+	ld d, a
+	ld a, c
+	add a
+	add a
+	add a
+	add d
+	ld l, a
+	ld a, [TYPES_PAGE]
+	ld h, a
+	ld [hl], b
+	inc hl
+	ld [hl], e
+	pop hl
+	pop de
+	pop bc
+	ret
