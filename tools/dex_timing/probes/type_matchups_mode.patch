+	call PokedexTypes_Initialize.OrdinalPosition
+	ld a, [TYPES_ROW]
+	ld e, a
+	ld d, 0
+	ld hl, PokedexTypes_Initialize.PixelRows
+	add hl, de
+	ld a, [hl]
+	add 16
+	ld [wShadowOAM], a
+	ld a, [TYPES_COLUMN]
+	ld b, a
+	add a
+	add b
+	swap a
+	add 16
+	ld [wShadowOAM + 1], a
+	ld a, TYPES_ARROW
+	ld [wShadowOAM + 2], a
+	ld a, OAM_BANK1
+	ld [wShadowOAM + 3], a
+	ret
