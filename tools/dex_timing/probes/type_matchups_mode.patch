+; Build one defensive result from the canonical battle chart, including records
+; after the Foresight divider. Battle-only modifiers are deliberately excluded.
+PokedexTypes_BuildMatchups::
+	ld hl, TYPES_EFFECTS
+	ld bc, 29
+	ld a, EFFECTIVE
+	call ByteFill
+	ldh a, [rSVBK]
+	push af
+	ld a, BANK(wPokedexInfoGFX)
+	ldh [rSVBK], a
+	ld hl, TypeMatchups
+	ld de, wPokedexInfoGFX
+	ld bc, TypeMatchupsEnd - TypeMatchups
+	ld a, BANK(TypeMatchups)
+	call FarCopyBytes
+	ld a, [TYPES_CURSOR]
+	ld e, a
+	ld d, 0
+	ld hl, TYPES_IDS
+	add hl, de
+	ld d, [hl]
+	ld hl, wPokedexInfoGFX
+.record
+	ld a, [hli]
+	cp -1
+	jr z, .lists
+	cp -2
+	jr z, .record
+	ld b, a
+	ld a, [hli]
+	ld c, a
+	ld a, [hli]
+	ld e, a
+	ld a, c
+	cp d
+	jr nz, .record
+	push hl
+	ld l, b
+	ld h, HIGH(TYPES_EFFECTS)
+	ld [hl], e
+	pop hl
+	jr .record
+.lists
+	pop af
+	ldh [rSVBK], a
+	xor a
+	ld [TYPES_I_COUNT], a
+	ld [TYPES_W_COUNT], a
+	ld [TYPES_R_COUNT], a
+	ld [TYPES_ORDINAL], a
+.type
+	ld a, [TYPES_ORDINAL]
+	ld e, a
+	ld d, 0
+	ld hl, TYPES_IDS
+	add hl, de
+	ld l, [hl]
+	ld h, HIGH(TYPES_EFFECTS)
+	ld a, [hl]
+	cp SUPER_EFFECTIVE
+	jr z, .weak
+	cp EFFECTIVE
+	jr nc, .next
+	and a
+	jr nz, .resist
+	; Steel keeps its compact combined resistance/immunity list.
+	ld a, [TYPES_CURSOR]
+	ld e, a
+	ld d, 0
+	ld hl, TYPES_IDS
+	add hl, de
+	ld a, [hl]
+	cp STEEL
+	jr z, .resist
+	ld hl, TYPES_I_COUNT
+	ld de, TYPES_I_LIST
+	jr .append
+.resist
+	ld hl, TYPES_R_COUNT
+	ld de, TYPES_R_LIST
+	jr .append
+.weak
+	ld hl, TYPES_W_COUNT
+	ld de, TYPES_W_LIST
+.append
+	ld a, [hl]
+	inc [hl]
+	ld l, a
+	ld h, 0
+	add hl, de
+	ld a, [TYPES_ORDINAL]
+	ld [hl], a
+.next
+	ld hl, TYPES_ORDINAL
+	inc [hl]
+	ld a, [hl]
+	cp NUM_TYPES
+	jr c, .type
+	ld a, [TYPES_W_COUNT]
+	cp 5
+	ld a, 14
+	jr c, .r_row
+	inc a
+.r_row
+	ld [TYPES_R_ROW], a
+	ret
+
+PokedexTypes_StageColours::
+	ld a, [TYPES_PAGE]
+	ld h, a
+	ld l, 0
+	ld bc, 96
+	xor a
+	call ByteFill
+	xor a
+	ld [TYPES_ORDINAL], a
+.top
+	call PokedexTypes_Initialize.OrdinalPosition
+	ld a, [TYPES_ROW]
+	inc a
+	ld c, a
+	ld a, [TYPES_COLUMN]
+	ld d, a
+	ld a, [TYPES_ORDINAL]
+	call PokedexTypes_StoreColour
+	ld hl, TYPES_ORDINAL
+	inc [hl]
+	ld a, [hl]
+	cp NUM_TYPES
+	jr c, .top
+	ret
