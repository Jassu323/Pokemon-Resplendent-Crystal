+PokedexTypes_Update::
+	call PokedexTypes_BlinkCursor
+	; Only VBlank accumulates edges, so this short exchange cannot delay a
+	; raster palette write beyond HBlank's available time.
+	di
+	ldh a, [hJoypadSum]
+	ld b, a
+	xor a
+	ldh [hJoypadSum], a
+	ei
+	ldh a, [hJoyPressed]
+	or b
+	and PAD_B | PAD_SELECT
+	jp nz, PokedexTypes_Leave
+	ld a, b
+	and PAD_CTRL_PAD
+	jr nz, .direction
+	ldh a, [hJoyLast]
+	and PAD_CTRL_PAD
+	ret z
+.direction
+	ld c, a
+	ld a, [TYPES_CURSOR]
+	ld [TYPES_ORDINAL], a
+	call PokedexTypes_Initialize.OrdinalPosition
+	bit B_PAD_UP, c
+	jr nz, .up
+	bit B_PAD_DOWN, c
+	jr nz, .down
+	bit B_PAD_LEFT, c
+	jr nz, .left
+	ld hl, TYPES_COLUMN
+	inc [hl]
+	ld a, [hl]
+	cp 3
+	jr c, .move
+	ld [hl], 0
+	jr .move
+.left
+	ld hl, TYPES_COLUMN
+	ld a, [hl]
+	and a
+	jr nz, .left_step
+	ld [hl], 3
+.left_step
+	dec [hl]
+	jr .move
+.up
+	ld hl, TYPES_ROW
+	ld a, [hl]
+	and a
+	jr nz, .up_step
+	ld [hl], 6
+.up_step
+	dec [hl]
+	jr .move
+.down
+	ld hl, TYPES_ROW
+	inc [hl]
+	ld a, [hl]
+	cp 6
+	jr c, .move
+	ld [hl], 0
+.move
+	farcall Pokedex_ResetArrowCursorBlink
+	ld a, [TYPES_ROW]
+	ld b, a
+	add a
+	add b
+	ld b, a
+	ld a, [TYPES_COLUMN]
+	add b
+	ld [TYPES_CURSOR], a
+	ld a, TRUE
+	ldh [hOAMUpdate], a
+	ldh a, [hLYOverrideStart]
+	xor TYPES_PAGE_A ^ TYPES_PAGE_B
+	ld [TYPES_PAGE], a
+	call PokedexTypes_DrawSelection
+	farcall Pokedex_StageOwnerTransitionMaps
+.near_vblank
+	ldh a, [rLY]
+	cp 140
+	jr c, .near_vblank
+	cp 144
+	jr nc, .near_vblank
+	di
+.vblank
+	ldh a, [rLY]
+	cp 144
+	jr c, .vblank
+	call PokedexTypes_CommitLower
+	ld a, [TYPES_PAGE]
+	ldh [hLYOverrideStart], a
+	call hTransferShadowOAM
+	xor a
+	ldh [hOAMUpdate], a
+	ei
+	ret
+
+PokedexTypes_BlinkCursor:
+	farcall Pokedex_AdvanceArrowCursorBlink
+	jr z, .visible
+	xor a
+	ld [wShadowOAM], a
+	ret
+.visible
+	jp PokedexTypes_DrawSelection.Cursor
+
+PokedexTypes_CommitLower:
+	ldh a, [rSVBK]
+	push af
+	ldh a, [rVBK]
+	push af
+	ld a, BANK(wPokedexOwnerTilemapBuffer)
+	ldh [rSVBK], a
+	ld a, 1
+	ldh [rVBK], a
+	ld hl, wPokedexOwnerAttrmapBuffer + 12 * TILEMAP_WIDTH
+	call .Transfer
+	xor a
+	ldh [rVBK], a
+	ld hl, wPokedexOwnerTilemapBuffer + 12 * TILEMAP_WIDTH
+	call .Transfer
+	pop af
+	ldh [rVBK], a
+	pop af
+	ldh [rSVBK], a
+	ret
+.Transfer:
+	ld a, h
+	ldh [rVDMA_SRC_HIGH], a
+	ld a, l
+	ldh [rVDMA_SRC_LOW], a
+	ld a, HIGH(vBGMap0 + 12 * TILEMAP_WIDTH) & $1f
+	ldh [rVDMA_DEST_HIGH], a
+	ld a, LOW(vBGMap0 + 12 * TILEMAP_WIDTH)
+	ldh [rVDMA_DEST_LOW], a
+	ld a, 2 * 5 - 1
+	ldh [rVDMA_LEN], a
+	ret
+PokedexTypes_Leave:
+	xor a
+	ldh [hLCDCPointer], a
+	ldh [hLYOverrideStart], a
+	farcall Pokedex_InitGridCacheState
+	farcall PokedexListing_BeginMenuTransition
+	ld a, DEXSELECT_STATE_TYPES_RETURN
+	ld [wPokedexSelectedState], a
+	ld a, DEXSTATE_OPTION_SCR
+	ld [wJumptableIndex], a
+	ret
