+.bounds
+	ld c, a
+	ld b, 0
+.minimum
+	bit 7, a
+	jr nz, .min_done
+	add a
+	inc b
+	jr .minimum
+.min_done
+	ld a, b
+	ld [wPokedexRuntimeGlyphMin], a
+	ld a, 8
+	sub b
+	ld b, a
+.maximum
+	bit 0, c
+	jr nz, .width
+	srl c
+	dec b
+	jr .maximum
+.width
+	ld a, b
+	ld [wPokedexRuntimeGlyphWidth], a
+.draw
+	ld a, [wPokedexRuntimeTextX]
+	srl a
+	srl a
+	srl a
+	ld l, a
+	ld h, 0
+	ld de, wPokedexRuntimeLine
+	add hl, de
+	ld a, l
+	ld [wPokedexRuntimeDrawPointer], a
+	ld a, h
+	ld [wPokedexRuntimeDrawPointer + 1], a
+	xor a
+	ld [wPokedexRuntimeGlyphRow], a
+.row
+	ld a, [wPokedexRuntimeGlyphRow]
+	ld l, a
+	ld h, 0
+	ld de, wPokedexRuntimeGlyph
+	add hl, de
+	ld b, [hl]
+	ld a, [wPokedexRuntimeGlyphMin]
+	ld c, a
+	and a
+	jr z, .cropped
+.crop
+	sla b
+	dec c
+	jr nz, .crop
+.cropped
+	ld a, b
+	ld [wPokedexRuntimeBits], a
+	ld a, [wPokedexRuntimeTextX]
+	and 7
+	ld c, a
+	jr z, .left_ready
+.left
+	srl b
+	dec c
+	jr nz, .left
+.left_ready
+	ld a, [wPokedexRuntimeDrawPointer]
+	ld l, a
+	ld a, [wPokedexRuntimeDrawPointer + 1]
+	ld h, a
+	ld a, b
+	or [hl]
+	ld [hli], a
+	ld a, [wPokedexRuntimeTextX]
+	and 7
+	jr z, .next_row
+	ld c, a
+	ld a, 8
+	sub c
+	ld c, a
+	ld a, [wPokedexRuntimeBits]
+.right
+	add a
+	dec c
+	jr nz, .right
+	or [hl]
+	ld [hl], a
+.next_row
+	ld de, 15
+	add hl, de
+	ld a, l
+	ld [wPokedexRuntimeDrawPointer], a
+	ld a, h
+	ld [wPokedexRuntimeDrawPointer + 1], a
+	ld hl, wPokedexRuntimeGlyphRow
