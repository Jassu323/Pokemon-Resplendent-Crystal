+PokedexRuntime_CopyTiles:
+; Runtime output already occupies GFX. Only atlas B needs a retained RAM copy.
+IF DEF(DEX_RUNTIME_RESTORE_ROM)
+	jp PokedexRuntime_CopyROMTiles
+ELIF DEF(DEX_RUNTIME_RESTORE_VRAM)
+	ld a, [wPokedexRuntimeReturnRepair]
+	and a
+	jr z, .ready
+	ld a, [wPokedexInfoCopyTile]
+	ld c, a
+	ld a, [wPokedexInfoTileCount]
+	sub c
+	jr z, .ready
+	cp 9
+	jr c, .count
+	ld a, 8
+.count
+	push af
+	ld l, c
+	ld h, 0
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	push hl
+	ld de, wPokedexInfoGFX
+	add hl, de
+	ld d, h
+	ld e, l
+	pop hl
+	ld bc, vTiles5
+	add hl, bc
+	pop af
+	push af
+	add a
+	add a
+	add a
+	ld b, a ; pairs of bytes
+	ldh a, [rVBK]
+	push af
+	ld a, 1
+	ldh [rVBK], a
+.pair
+	; Mode 0/1 has at least the next 80-dot mode 2 before VRAM locks.
+	; Two reads finish within that margin even at normal CPU speed. DI
+	; prevents an interrupt from invalidating the sampled STAT window.
+	di
+.wait_vram
+	ldh a, [rSTAT]
+	and 2
+	jr nz, .wait_vram
+	ld a, [hli]
+	ld [de], a
+	inc de
+	ld a, [hli]
+	ld [de], a
+	inc de
+	ei
+	dec b
+	jr nz, .pair
+	pop af
+	ldh [rVBK], a
+	pop bc
+	ld a, [wPokedexInfoCopyTile]
+	add b
+	ld [wPokedexInfoCopyTile], a
+	ret
+.ready
+	ld a, [wPokedexInfoTileCount]
+	ld [wPokedexInfoCopyTile], a
+	ld a, POKEDEX_INFO_UPLOAD
+	ld [wPokedexInfoState], a
+	ret
+ELSE
+	ld a, [wPokedexRuntimeReturnRepair]
+	and a
+	jr nz, .copy
+	ld a, [wPokedexInfoAtlasBuffer]
+	and a
+	jr nz, .copy
+	ld a, [wPokedexInfoTileCount]
+	ld [wPokedexInfoCopyTile], a
+	jr .ready
+.copy
+	ld a, [wPokedexInfoCopyTile]
+	ld c, a
+	ld a, [wPokedexInfoTileCount]
+	sub c
+	jr z, .ready
+	cp 9
+	jr c, .count
+	ld a, 8
+.count
+	ld [wPokedexRuntimeNumberTile], a
+	ld h, 0
+	ld l, c
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	add hl, hl
+	push hl
+	ld a, [wPokedexRuntimeReturnRepair]
+	and a
+	jr nz, .repair
+	ld de, wPokedexInfoGFX
+	add hl, de
+	ld de, POKEDEX_ANIM_PAYLOAD
+	call .length
+	call CopyBytes
+	pop hl
+	ld de, wPokedexRuntimeVisibleBGFX
+	add hl, de
+	ld d, h
+	ld e, l
+	ld hl, POKEDEX_ANIM_PAYLOAD
+	call .length
+	ld a, BANK(wPokedexRuntimeVisibleBGFX)
+	ldh [rSVBK], a
+	call CopyBytes
+	ld a, BANK(wPokedexInfoState)
+	ldh [rSVBK], a
+	jr .copied
+.repair
+	ld de, wPokedexRuntimeVisibleBGFX
+	add hl, de
+	ld de, POKEDEX_ANIM_PAYLOAD
+	call .length
+	ld a, BANK(wPokedexRuntimeVisibleBGFX)
+	ldh [rSVBK], a
+	call CopyBytes
+	ld a, BANK(wPokedexInfoState)
+	ldh [rSVBK], a
+	pop hl
+	ld de, wPokedexInfoGFX
+	add hl, de
+	ld d, h
+	ld e, l
+	ld hl, POKEDEX_ANIM_PAYLOAD
+	call .length
+	call CopyBytes
+.copied
+	ld a, [wPokedexRuntimeNumberTile]
+	ld b, a
+	ld a, [wPokedexInfoCopyTile]
+	add b
+	ld [wPokedexInfoCopyTile], a
+	ret
+.ready
+	ld a, POKEDEX_INFO_UPLOAD
+	ld [wPokedexInfoState], a
+	ret
+.length
+	ld a, [wPokedexRuntimeNumberTile]
+	swap a
+	ld c, a
+	ld b, 0
+	ret
+ENDC
